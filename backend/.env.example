# Copy to .env and adjust as needed. All have working defaults for
# local dev (SQLite, localhost CORS) so the app runs with none of this set.

# Storage -- the architecture calls for Postgres; docker-compose.yml
# stands one up in one command (`docker compose up -d db`). Leave
# DATABASE_URL unset to fall back to local SQLite with zero setup.
DATABASE_URL=sqlite:///./phishscan.db
# DATABASE_URL=postgresql+psycopg2://phishscan:phishscan@localhost:5432/phishscan
REDIS_URL=redis://localhost:6379/0

# Frontend origin allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Evidence collection tuning
HTTP_TIMEOUT_SECONDS=6
DNS_TIMEOUT_SECONDS=4
TLS_TIMEOUT_SECONDS=4
CT_LOOKUP_ENABLED=true

# --- Real-time threat-intelligence feeds --------------------------------
# PhishTank: works with no key at a lower rate limit. Get a free key at
# https://www.phishtank.com/api_register.php to raise it -- never commit
# it, just set it here or as a real environment variable.
PHISHTANK_APP_KEY=
PHISHTANK_FEED_URL=https://data.phishtank.com/data/online-valid.csv
PHISHTANK_SYNC_INTERVAL_MINUTES=60

# OpenPhish: community feed needs no key. If you have academic/commercial
# access, point OPENPHISH_FEED_URL at your issued feed URL and set the key.
OPENPHISH_FEED_URL=https://openphish.com/feed.txt
OPENPHISH_API_KEY=
OPENPHISH_SYNC_INTERVAL_MINUTES=60

# Background sync scheduler -- keeps the threat-intel table current with
# zero manual dataset uploads. Turn off for tests/CI.
ENABLE_FEED_SCHEDULER=true
SYNC_ON_STARTUP=true

# Historical baseline dataset (Phase 1 training comparison only, not used
# by the live API)
UCI_PHISHING_URL=https://archive.ics.uci.edu/static/public/327/phishing+websites.zip

# --- Model selection ----------------------------------------------------
# true  (default): score with the synthetic-data models (artifacts/synthetic/),
#                  falling back to the original real-data models automatically
#                  if they are missing or fail.
# false: use ONLY the original real-data models.
USE_SYNTHETIC_MODELS=true
